{
  "name": "trabajo-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Cascarón de app dashboard (sidebar + topbar + auth real contra MySQL) para arrancar proyectos nuevos",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
